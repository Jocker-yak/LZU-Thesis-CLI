{
  "manifest_version": 3,
  "name": "兰大论文全文助手",
  "version": "1.0.1",
  "description": "在已登录的浏览器里从兰州大学论文门户检索，并把阅读器渲染的学位论文页面合成为图片版 PDF 下载。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "兰大论文全文助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "app.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "downloads",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "http://202.201.7.17/*",
    "http://202.201.7.29/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://202.201.7.29/*"
      ],
      "js": [
        "content-reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://202.201.7.17/*"
      ],
      "js": [
        "content-portal.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
