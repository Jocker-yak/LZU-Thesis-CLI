{
  "name": "lzu-fulltext-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LZU 论文全文助手 —— 把 LZU-Thesis-CLI 的抓取流程做成 Chrome / Firefox 浏览器插件",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test-key",
    "package": "node scripts/zip.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:all": "npm run test && npm run test:e2e",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "smoke:live": "node tests/e2e/live-portal.mjs",
    "fixtures:capture": "node tests/fixtures/capture.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.64.1",
    "web-ext": "^10.8.0"
  }
}
